# Copy this file to .env.local and fill in the values.
#
#   cp .env.local.example .env.local
#
# Everything below is required — the app will fail at runtime (or silently
# stop paying artists, in the webhooks' case) if any of them is missing.

# ---------------------------------------------------------------------------
# Supabase — Settings -> API in the Supabase dashboard
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security. Used only by server-side code that has no user
# session to act as — the Stripe webhooks recording purchases/gifts/
# subscriptions, and the public artist page's metadata lookup. Never expose
# this to the browser (no NEXT_PUBLIC_ prefix, and don't add one).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------

# Used to build Stripe Checkout success/cancel URLs and Connect return URLs.
# MUST be https:// — Stripe's Account Links v2 rejects http:// return URLs
# even for localhost, so use an HTTPS tunnel (ngrok or similar) in dev rather
# than http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-tunnel-or-domain

# ---------------------------------------------------------------------------
# Stripe — Developers -> API keys / Webhooks
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_your-secret-key

# Three separate webhook destinations, each with its own signing secret.
# Create all three in the Stripe Dashboard (Developers -> Webhooks), or run
# `stripe listen --forward-to localhost:3000/<path>` per destination locally
# and use the secret each one prints.
#
# 1. /api/webhooks/stripe — checkout.session.completed
#    Records purchases and gifts, and transfers the artist's cut.
STRIPE_WEBHOOK_SECRET=whsec_your-checkout-webhook-secret

# 2. /api/webhooks/stripe — charge.refunded, charge.dispute.created,
#    charge.dispute.closed
#    Same route as above; the route tries both secrets in turn, so refunds and
#    disputes can live in their own Dashboard destination.
STRIPE_WEBHOOK_SECRET_REFUNDS=whsec_your-refunds-webhook-secret

# 3. /api/webhooks/stripe-subscriptions — customer.subscription.created,
#    customer.subscription.updated, customer.subscription.deleted
#    Super Fan subscription lifecycle.
STRIPE_WEBHOOK_SECRET_SUBSCRIPTIONS=whsec_your-subscriptions-webhook-secret
